GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL=https://localhost:8443/api/auth/google/callback

# PostgreSQL administrator (superuser of database!)
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=transcendence

# PostgreSQL administrator connection — local maintenance only
DATABASE_URL="postgresql://transcendence:change_me@localhost:5432/transcendence?schema=public"

# PostgreSQL administrator connection — Docker network maintenance only
DATABASE_URL_DOCKER="postgresql://transcendence:change_me@postgres:5432/transcendence?schema=public"

# Application account (API runtime and seed only)
TRANSCENDENCE_APP_PASSWORD=change_me_to_a_secure_password
DATABASE_URL_APP_DOCKER="postgresql://transcendence_app:change_me@postgres:5432/transcendence?schema=public"

# Prisma migration account (schema migrations only)
TRANSCENDENCE_MIGRATOR_PASSWORD=change_me_to_a_secure_password
DATABASE_URL_MIGRATOR_DOCKER="postgresql://transcendence_migrator:change_me@postgres:5432/transcendence?schema=public"

SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-me"

# JWT Secret generated by openssl rand -base64 32
JWT_SECRET="change-me"

# Email Configuration (optional - if not configured, emails will be skipped)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="noreply@yourdomain.com"

# Application Base URL (used for links in emails)
APP_BASE_URL="https://localhost:8443"
