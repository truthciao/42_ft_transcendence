{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/test/tsconfig.spec.json",
        "useESM": false
      }
    ]
  },
  "moduleNameMapper": {
    "^@repo/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
