GOOGLE_CLIENT_ID="your_google_client_id_here"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"
GOOGLE_CALLBACK_URL="https://localhost:8443/api/auth/google/callback"
DATABASE_URL="postgresql://transcendence:transcendence@localhost:5432/transcendence?schema=public"

#JWT Secret generated by openssl rand -base64 32
JWT_SECRET=

# Email Configuration (optional - if not configured, emails will be skipped)
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_SECURE="false"
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-app-password"
MAIL_FROM="noreply@yourdomain.com"

# Application Base URL (used for links in emails)
APP_BASE_URL="http://localhost:5173"
